<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ainews.daily-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/zhengjiabei/Downloads/NEWS/scripts/run_daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/zhengjiabei/Downloads/NEWS</string>

    <!--
      Two daily triggers (local fallback; GitHub Actions is primary):
      10:00 — morning delivery
      16:00 — afternoon retry if morning failed (machine asleep, etc.)
    -->
    <key>StartCalendarIntervals</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>16</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/zhengjiabei/Downloads/NEWS/logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/zhengjiabei/Downloads/NEWS/logs/stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
